# Keycloak admin account and server settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloakdbpassword
KEYCLOAK_HTTP_PORT=8080

# Keycloak database settings
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=${KEYCLOAK_DB_PASSWORD}

# Application database settings (tasks API)
APP_DB_USER=appuser
APP_DB_PASSWORD=apppassword123
APP_DB_NAME=tasksdb
APP_DB_HOST=tasks-db
APP_DB_PORT=5432

# Backend Keycloak/OAuth settings
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=task-app-realm
KEYCLOAK_AUDIENCE=task-app-frontend

# Frontend settings (Vite env variables for local development)
VITE_API_BASE_URL=http://localhost:5000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=task-app-realm
VITE_KEYCLOAK_CLIENT_ID=task-app-frontend

KEYCLOAK_BACKEND_CLIENT_SECRET=your-backend-client-secret
